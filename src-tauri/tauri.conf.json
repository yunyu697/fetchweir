{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fetchweir",
  "version": "../version.json",
  "identifier": "dev.fetchweir.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fetchweir",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"],
    "resources": {
      "../extension": "extension"
    },
    "shortDescription": "Fetchweir 下载管理器",
    "longDescription": "Fetchweir 是跨平台下载管理器，支持分段并发下载、断点续传与浏览器扩展资源嗅探。",
    "copyright": "© 2026 Fetchweir",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
